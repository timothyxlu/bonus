{
  "name": "@bonus/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "cf-typegen": "wrangler types --include-runtime=false src/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/catalog.sql",
    "seed:generate": "node --experimental-strip-types scripts/generate-seed.ts"
  },
  "dependencies": {
    "@bonus/core": "workspace:*",
    "@cloudflare/workers-oauth-provider": "^1.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@simplewebauthn/server": "14.1.0",
    "agents": "^0.34.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.167.0"
  }
}
